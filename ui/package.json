{
  "name": "@selfxyz/ui",
  "version": "0.0.1",
  "description": "UI Components for Self Apps.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "build": "yarn build:tamagui",
    "build:clean": "rm -rf dist",
    "build:tamagui": "tamagui-build --config ./src/tamagui.config.ts   --out dist",
    "types": "tsc --b --declaration --emitDeclarationOnly",
    "lint": "eslint ./src/ --ext .ts,.tsx && prettier --check ./src",
    "lint:fix": "eslint --fix ./src/ --ext .ts,.tsx && prettier --write ./src"
  },
  "dependencies": {
    "@tamagui/config": "1.126.16",
    "react": "^18.3.1",
    "react-native": "0.0.0",
    "react-native-haptic-feedback": "^2.3.3",
    "tamagui": "1.126.16"
  },
  "devDependencies": {
    "@tamagui/build": "^1.126.16",
    "@types/node": "^24.0.1",
    "@types/react-native": "^0.73.0",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.3.3",
    "react-native-svg": "^15.11.1",
    "react-native-svg-transformer": "^1.5.0",
    "tsx": "^4.20.2",
    "typescript": "^5.8.3"
  }
}
