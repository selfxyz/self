{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node18",
    "declaration": true,
    "declarationDir": "./dist",
    "outDir": "./dist",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node16",
    "baseUrl": "./src",
  },
  "include": [
    "src/**/*",
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
