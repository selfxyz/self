{
  "name": "@selfxyz/react",
  "version": "0.1.0",
  "description": "React component wrapper for Self verification widget",
  "repository": {
    "type": "git",
    "url": "https://github.com/selfxyz/self.git",
    "directory": "sdk/react"
  },
  "homepage": "https://self.xyz",
  "keywords": ["self", "identity", "verification", "react", "component"],
  "license": "MIT",
  "author": "selfxyz",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:deps": "yarn workspaces foreach --from @selfxyz/react --topological-dev --recursive run build",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "prepublishOnly": "yarn build",
    "test": "echo 'no tests yet'",
    "types": "tsc --noEmit"
  },
  "dependencies": {
    "@selfxyz/widget": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "prettier": "^3.5.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "publishConfig": {
    "access": "public"
  }
}
