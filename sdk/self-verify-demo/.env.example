# App name shown in the Self app during verification
NEXT_PUBLIC_SELF_APP_NAME=Self Verify Demo

# Scope — must match between widget and backend verifier
NEXT_PUBLIC_SELF_APP_SCOPE=self-verify-demo

# Public URL where the Self app can POST the proof.
# For local dev: run `ngrok http 3000` and paste the ngrok URL here.
# For production: your deployed domain (e.g. https://verify-demo.self.xyz)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WebSocket relayer
NEXT_PUBLIC_WS_RELAY_URL=wss://websocket.self.xyz

# NextAuth session secret (required — generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
