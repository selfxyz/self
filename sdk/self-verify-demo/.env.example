# Required — app identifier registered with Self
NEXT_PUBLIC_SELF_APP_SCOPE=self-verify-demo

# Required — verify-service base URL (default: https://verify.self.xyz)
NEXT_PUBLIC_VERIFY_SERVICE_URL=https://verify.self.xyz

# Required — WebSocket relayer (default: wss://websocket.self.xyz)
NEXT_PUBLIC_WS_RELAY_URL=wss://websocket.self.xyz

# Required for Server-Side Auth section (token/OAuth mode)
SELF_APP_ID=
SELF_CLIENT_SECRET=

# Optional — callback URL for OAuth flows
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-random-secret-here
