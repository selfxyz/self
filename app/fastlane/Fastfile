# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#     https://docs.fastlane.tools/actions
#

opt_out_usage

require 'base64'
require_relative 'helpers'

is_ci = ENV['CI'] && !ENV['ACT']
local_development = !is_ci

if local_development
  puts "Loading .env.secrets"
  require 'dotenv'
  Dotenv.load('./.env.secrets')
end

default_platform(:ios)

platform :ios do
  # Private lane for common iOS build setup
  private_lane :prepare_ios_build do |options|
    if is_ci
      setup_ci
      increment_build_number(xcodeproj: "ios/Self.xcodeproj")
    end

    required_env_vars = [
      "IOS_APP_IDENTIFIER",
      "IOS_CONNECT_API_KEY",
      "IOS_CONNECT_ISSUER_ID",
      "IOS_CONNECT_KEY_ID"
    ]

    Fastlane::Helpers.verify_env_vars(required_env_vars)
    Fastlane::Helpers.verify_distribution_certificate if is_ci
    Fastlane::Helpers.verify_ios_app_store_build_number

    cocoapods(podfile: "ios/Podfile")

    api_key = app_store_connect_api_key(
      key_id: ENV["IOS_CONNECT_KEY_ID"],
      issuer_id: ENV["IOS_CONNECT_ISSUER_ID"],
      key_content: ENV["IOS_CONNECT_API_KEY"],
      in_house: false
    )
    
    build_app(
      workspace: "ios/Self.xcworkspace",
      scheme: "OpenPassport",
      export_method: "app-store",
      output_directory: "build",
      clean: true,
    )

    should_upload = Fastlane::Helpers.should_upload_app(options[:for_testflight] ? "TestFlight" : "App Store")

    {
      api_key: api_key,
      should_upload: should_upload
    }
  end

  desc "Push a new build to TestFlight Internal Testing"
  lane :internal_test do
    result = prepare_ios_build(for_testflight: true)

    upload_to_testflight(
      api_key: result[:api_key],
      distribute_external: true,
      groups: ENV["IOS_TESTFLIGHT_GROUPS"].split(","),
      changelog: ""
    ) if result[:should_upload]
  end

  desc "Prepare a new build for App Store submission"
  lane :deploy do
    result = prepare_ios_build(for_testflight: false)

    upload_to_app_store(
      api_key: result[:api_key],
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: false,
      automatic_release: false
    ) if result[:should_upload]
  end
end

platform :android do
  desc "Push a new build to Google Play Internal Testing"
  lane :internal_test do
    if is_ci
      increment_version_code(
        gradle_file_path: "android/app/build.gradle"
      )
    end

    Fastlane::Helpers.verify_env_vars([
      "ANDROID_KEYSTORE",
      "ANDROID_KEYSTORE_PASSWORD",
      "ANDROID_KEYSTORE_PATH",
      "ANDROID_KEY_ALIAS",
      "ANDROID_KEY_PASSWORD",
      "ANDROID_PLAY_STORE_JSON_KEY"
    ])
    
    # Verify version code before building 
    # TODO: uncomment this when we have a way to test the version code
    # Fastlane::Helpers.verify_android_version_code
    
    keystore_path = Fastlane::Helpers.create_android_keystore

    # Verify keystore path matches environment variable
    if keystore_path != ENV["ANDROID_KEYSTORE_PATH"]
      UI.user_error!("Generated keystore path (#{keystore_path}) does not match ANDROID_KEYSTORE_PATH environment variable (#{ENV['ANDROID_KEYSTORE_PATH']})")
    end

    # Build the Android app
    gradle(
      task: "clean bundleRelease",
      project_dir: "android/",
      properties: {
        "android.injected.signing.store.file" => keystore_path,
        "android.injected.signing.store.password" => ENV["ANDROID_KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["ANDROID_KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["ANDROID_KEY_PASSWORD"]
      }
    )

    should_upload = Fastlane::Helpers.should_upload_app("Google Play")
    
    upload_to_play_store(
      track: "internal",
      json_key_data: ENV["ANDROID_PLAY_STORE_JSON_KEY"],
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "completed",
      aab: "android/app/build/outputs/bundle/release/app-release.aab"
    ) if should_upload
  end
end