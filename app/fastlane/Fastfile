# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#     https://docs.fastlane.tools/actions
#

opt_out_usage

require 'base64'

is_ci = ENV['CI']

# for local development
unless is_ci
  puts "Loading .env.secrets"
  require 'dotenv'
  Dotenv.load('.env.secrets')
end

default_platform(:ios)

platform :ios do
  desc "Push a new build to TestFlight Internal Testing"
  lane :internal_test do
    if is_ci
      setup_ci
      # Update app version and build number if needed
      increment_build_number(xcodeproj: "ios/Self.xcodeproj")
    else
      verify_env_vars([
        "APP_STORE_CONNECT_KEY_ID",
        "APP_STORE_CONNECT_ISSUER_ID",
        "APP_STORE_CONNECT_API_KEY",
        "APP_STORE_TESTFLIGHT_GROUPS"
      ])
    end

    verify_ios_app_store_build_number

    cocoapods(podfile: "ios/Podfile")
    
    # Build the app
    build_app(
      workspace: "ios/Self.xcworkspace",
      scheme: "OpenPassport",
      export_method: "app-store",
      output_directory: "build",
      clean: true
    )
    
    # Upload to TestFlight
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"]
    )
    
    unless is_ci
      puts "Skipping upload to TestFlight because CI is false"
      return
    end
    
    upload_to_testflight(
      api_key: api_key,
      distribute_external: true,
      groups: ENV["APP_STORE_TESTFLIGHT_GROUPS"].split(","),
      changelog: ""
    )
  end
end

platform :android do
  desc "Push a new build to Google Play Internal Testing"
  lane :internal_test do
    if is_ci
      setup_ci
      # Update app version and build number if needed
      increment_version_code(
        gradle_file_path: "android/app/build.gradle"
      )
    else
      verify_env_vars([
        "ANDROID_KEYSTORE",
        "ANDROID_KEYSTORE_PASSWORD",
        "ANDROID_KEY_ALIAS",
        "ANDROID_KEY_PASSWORD",
        "PLAY_STORE_JSON_KEY"
      ])
    end
    
    # Verify version code before building
    verify_android_version_code
    
    keystore_path = create_android_keystore

    # Build the Android app
    gradle(
      task: "clean bundleRelease",
      project_dir: "android/",
      properties: {
        "android.injected.signing.store.file" => keystore_path,
        "android.injected.signing.store.password" => ENV["ANDROID_KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["ANDROID_KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["ANDROID_KEY_PASSWORD"]
      }
    )

    # unless is_ci
    #   puts "Skipping upload to Google Play because CI is false"
    #   return
    # end
    
    # Upload to Google Play
    upload_to_play_store(
      track: "internal",
      json_key_data: ENV["PLAY_STORE_JSON_KEY"],
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "completed",
      aab: "android/app/build/outputs/bundle/release/app-release.aab"
    )
  end
end 

# for local development
def verify_env_vars(required_vars)
  missing_vars = required_vars.select { |var| ENV[var].nil? || ENV[var].empty? }
  
  if missing_vars.any?
    report_error(
      "Missing required environment variables: #{missing_vars.join(', ')}",
      "Please check your .env.secrets file",
      "Environment verification failed"
    )
  else
    report_success("All required environment variables are present")
  end
end

# Helper methods for consistent error and success reporting
def report_error(message, suggestion = nil, abort_message = nil)
  UI.error("❌ #{message}")
  UI.error(suggestion) if suggestion
  UI.abort_with_message!(abort_message || message)
end

def report_success(message)
  UI.success("✅ #{message}")
end

# Verify build number against App Store Connect
# Because the app store api will auto increment the build number
def verify_ios_app_store_build_number
  api_key = app_store_connect_api_key(
    key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
    issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
    key_content: ENV["APP_STORE_CONNECT_API_KEY"]
  )
  
  latest_build = latest_testflight_build_number(
    api_key: api_key,
    app_identifier: ENV["APP_STORE_APP_IDENTIFIER"],
  )
  
  project = Xcodeproj::Project.open("../ios/Self.xcodeproj")
  target = project.targets.first
  current_build = target.build_configurations.first.build_settings["CURRENT_PROJECT_VERSION"]
  
  if current_build.to_i <= latest_build.to_i
    report_error(
      "Build number must be greater than latest TestFlight build!",
      "Latest TestFlight build: #{latest_build}\nCurrent build: #{current_build}\nPlease increment the build number in the project settings",
      "Build number verification failed"
    )
  else
    report_success("Build number verified (Current: #{current_build}, Latest TestFlight: #{latest_build})")
  end
end

# Verify version code against Google Play Console
# Because the Play Store API will auto increment the version code
def verify_android_version_code
  # Get the latest version code from Google Play Console
  latest_version = google_play_track_version_codes(
    track: "internal",
    json_key_data: ENV["PLAY_STORE_JSON_KEY"]
  ).first

  # Read current version code from build.gradle
  gradle_file = "../android/app/build.gradle"
  version_code_line = File.readlines(gradle_file).find { |line| line.include?("versionCode") }
  current_version = version_code_line.match(/versionCode\s+(\d+)/)[1].to_i

  if current_version <= latest_version
    report_error(
      "Version code must be greater than latest Play Store version!",
      "Latest Play Store version: #{latest_version}\nCurrent version: #{current_version}\nPlease increment the version code in android/app/build.gradle",
      "Version code verification failed"
    )
  else
    report_success("Version code verified (Current: #{current_version}, Latest Play Store: #{latest_version})")
  end
end

def create_android_keystore
  keystore_path = "../android/app/upload-keystore.jks"
  if ENV["ANDROID_KEYSTORE"]
    puts "Decoding Android keystore..."
    FileUtils.mkdir_p(File.dirname(keystore_path))
    File.write(keystore_path, Base64.decode64(ENV["ANDROID_KEYSTORE"]))
  end

  File.realpath(keystore_path)
end