{
  "name": "@selfxyz/circuits",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "author": "self team",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./testing": {
      "types": "./dist/esm/testing/index.d.ts",
      "import": "./dist/esm/testing/index.js",
      "require": "./dist/cjs/testing/index.cjs"
    },
    "./circuits/*": "./circuits/*"
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist/**/*",
    "circuits/**/*"
  ],
  "scripts": {
    "build": "tsup && yarn build:types && yarn postbuild",
    "postbuild": "node ./scripts/postBuild.mjs",
    "build-all": "bash scripts/build/build_register_circuits.sh && bash scripts/build/build_register_circuits_id.sh && bash scripts/build/build_dsc_circuits.sh && bash scripts/build/build_disclose_circuits.sh",
    "build-disclose": "bash scripts/build/build_disclose_circuits.sh",
    "build-dsc": "bash scripts/build/build_dsc_circuits.sh",
    "build-register": "bash scripts/build/build_register_circuits.sh",
    "build-register-id": "bash scripts/build/build_register_circuits_id.sh",
    "build-tests": "tsc -p tsconfig.spec.json",
    "build:deps": "yarn workspaces foreach --from @selfxyz/circuits --topological-dev --recursive run build",
    "build:types": "tsc -p tsconfig.types.json && node scripts/organize-types.mjs",
    "build:watch": "tsup --watch",
    "download": "bash scripts/server/download_circuits_from_AWS.sh",
    "format": "prettier --write .",
    "install-circuits": "yarn workspaces focus @selfxyz/circuits",
    "lint": "prettier --check .",
    "nice": "prettier --write .",
    "test": "yarn build-tests && NODE_OPTIONS='--experimental-json-modules --max-old-space-size=${NODE_MEMORY_LIMIT:-8192}' yarn test-base 'dist/tests/**/*.test.js' --exit",
    "test-base": "PATH=./scripts:$PATH mocha --parallel --jobs 2",
    "test-custom-hasher": "yarn build-tests && NODE_OPTIONS='--experimental-json-modules --max-old-space-size=${NODE_MEMORY_LIMIT:-8192}' yarn test-base 'dist/tests/other_circuits/custom_hasher.test.js' --exit",
    "test-disclose": "yarn build-tests && NODE_OPTIONS='--experimental-json-modules --max-old-space-size=${NODE_MEMORY_LIMIT:-8192}' yarn test-base 'dist/tests/disclose/vc_and_disclose.test.js' --exit",
    "test-disclose-id": "yarn build-tests && NODE_OPTIONS='--experimental-json-modules --max-old-space-size=${NODE_MEMORY_LIMIT:-8192}' yarn test-base 'dist/tests/disclose/vc_and_disclose_id.test.js' --exit",
    "test-dsc": "yarn build-tests && NODE_OPTIONS='--experimental-json-modules --max-old-space-size=${NODE_MEMORY_LIMIT:-8192}' yarn test-base 'dist/tests/dsc/dsc.test.js' --exit",
    "test-ecdsa": "yarn build-tests && NODE_OPTIONS='--experimental-json-modules --max-old-space-size=${NODE_MEMORY_LIMIT:-8192}' yarn test-base 'dist/tests/utils/ecdsa.test.js' --exit",
    "test-is-older-than": "yarn build-tests && NODE_OPTIONS='--experimental-json-modules --max-old-space-size=${NODE_MEMORY_LIMIT:-8192}' yarn test-base 'dist/tests/other_circuits/is_older_than.test.js' --exit",
    "test-is-valid": "yarn build-tests && NODE_OPTIONS='--experimental-json-modules --max-old-space-size=${NODE_MEMORY_LIMIT:-8192}' yarn test-base 'dist/tests/other_circuits/is_valid.test.js' --exit",
    "test-not-in-list": "yarn build-tests && NODE_OPTIONS='--experimental-json-modules --max-old-space-size=${NODE_MEMORY_LIMIT:-8192}' yarn test-base 'dist/tests/other_circuits/prove_country_is_not_in_list.test.js' --exit",
    "test-ofac": "yarn build-tests && NODE_OPTIONS='--experimental-json-modules --max-old-space-size=${NODE_MEMORY_LIMIT:-8192}' yarn test-base 'dist/tests/ofac/ofac.test.js' --exit",
    "test-register": "yarn build-tests && NODE_OPTIONS='--experimental-json-modules --max-old-space-size=${NODE_MEMORY_LIMIT:-8192}' yarn test-base 'dist/tests/register/register.test.js' --exit",
    "test-register-id": "yarn build-tests && NODE_OPTIONS='--experimental-json-modules --max-old-space-size=${NODE_MEMORY_LIMIT:-8192}' yarn test-base 'dist/tests/register_id/register_id.test.js' --exit",
    "test-rsa": "yarn build-tests && NODE_OPTIONS='--experimental-json-modules --max-old-space-size=${NODE_MEMORY_LIMIT:-8192}' yarn test-base 'dist/tests/utils/rsaPkcs1v1_5.test.js' --exit",
    "test-rsa-pss": "yarn build-tests && NODE_OPTIONS='--experimental-json-modules --max-old-space-size=${NODE_MEMORY_LIMIT:-8192}' yarn test-base 'dist/tests/utils/rsapss.test.js' --exit",
    "types": "yarn build --noEmit"
  },
  "dependencies": {
    "@noble/curves": "^1.4.2",
    "@openpassport/zk-email-circuits": "^6.1.2",
    "@openpassport/zk-kit-imt": "^0.0.4",
    "@openpassport/zk-kit-lean-imt": "^0.0.4",
    "@openpassport/zk-kit-smt": "^0.0.1",
    "@selfxyz/common": "workspace:^",
    "@types/chai-as-promised": "^7.1.6",
    "@types/node": "^20.11.19",
    "@types/node-forge": "^1.3.5",
    "@zk-email/circuits": "^6.3.2",
    "@zk-email/helpers": "^6.1.1",
    "@zk-email/zk-regex-circom": "^1.2.1",
    "@zk-kit/binary-merkle-root.circom": "https://gitpkg.vercel.app/Vishalkulkarni45/zk-kit.circom/packages/binary-merkle-root?fix/bin-merkle-tree",
    "@zk-kit/circuits": "^1.0.0-beta",
    "asn1": "^0.2.6",
    "asn1.js": "^5.4.1",
    "asn1js": "^3.0.5",
    "chai-as-promised": "^7.1.1",
    "circom-bigint": "https://github.com/0xbok/circom-bigint",
    "circom-dl": "https://github.com/distributed-lab/circom-dl",
    "circom_tester": "github:remicolin/circom_tester#main",
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.7",
    "elliptic": "^6.5.5",
    "hash.js": "^1.1.7",
    "js-sha256": "^0.10.1",
    "jsrsasign": "^11.1.0",
    "modpow": "^1.0.0",
    "node-forge": "https://github.com/remicolin/forge",
    "poseidon-lite": "^0.2.0",
    "snarkjs": "^0.7.1",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@types/chai": "4.3.11",
    "@types/circomlibjs": "^0.1.6",
    "@types/mocha": "^10.0.10",
    "@yarnpkg/sdks": "^3.2.0",
    "chai": "4.3.8",
    "mocha": "^10.3.0",
    "prettier": "^3.3.3",
    "ts-mocha": "^10.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
