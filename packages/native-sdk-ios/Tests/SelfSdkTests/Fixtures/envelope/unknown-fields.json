    "provider": {
      "nfc.scanPassport": {
        "progress": [
          {
            "step": "waiting_for_tag",
            "percent": 0
          }
        ],
        "pending": true
      }
    }
  },
  "steps": [
    {
      "send": {
        "type": "request",
        "version": 2,
        "id": "r1",
        "domain": "nfc",
        "method": "scanPassport",
        "params": {
          "passportNumber": "L898902C3",
          "dateOfBirth": "740812",
          "dateOfExpiry": "120415"
        },
        "timestamp": 0,
        "trace": "a1"
      }
    },
    {
      "expect": {
        "type": "event",
