{
  "name": "errors/invalid-params-timeout-ms",
  "given": {
    "capabilities": "full",
    "provider": {
      "nfc.scanPassport": {
        "pending": true
      }
    }
  },
  "steps": [
    {
      "send": {
        "type": "request",
        "version": 2,
        "id": "r1",
        "domain": "nfc",
        "method": "scanPassport",
        "params": {
          "passportNumber": "L898902C3",
          "dateOfBirth": "740812",
          "dateOfExpiry": "120415",
          "timeoutMs": "soon"
        },
        "timestamp": 0
      }
    },
    {
      "expect": {
        "type": "response",
        "version": 2,
        "domain": "nfc",
        "requestId": "r1",
        "success": false,
        "error": {
          "code": "INVALID_PARAMS",
          "details": {
            "field": "timeoutMs"
          }
        }
      }
    }
  ]
}
