{
  "name": "timeout/mrz-no-default",
  "given": {
    "capabilities": "full",
    "provider": {
      "camera.scanMRZ": {
        "pending": true
      }
    }
  },
  "steps": [
    {
      "send": {
        "type": "request",
        "version": 2,
        "id": "r1",
        "domain": "camera",
        "method": "scanMRZ",
        "params": {},
        "timestamp": 0
      }
    },
    {
      "advance": 600000
    },
    {
      "send": {
        "type": "cancel",
        "version": 2,
        "id": "c1",
        "domain": "camera",
        "requestId": "r1",
        "reason": "navigation",
        "timestamp": 0
      }
    },
    {
      "expect": {
        "type": "response",
        "version": 2,
        "domain": "camera",
        "requestId": "r1",
        "success": false,
        "error": {
          "code": "CANCELLED"
        }
      }
    }
  ]
}
