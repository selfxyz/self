{
  "name": "timeout/progress-then-timeout",
  "given": {
    "capabilities": "full",
    "provider": {
      "nfc.scanPassport": {
        "progress": [
          {
            "step": "waiting_for_tag",
            "percent": 0
          }
        ],
        "pending": true
      }
    }
  },
  "steps": [
    {
      "send": {
        "type": "request",
        "version": 2,
        "id": "r1",
        "domain": "nfc",
        "method": "scanPassport",
        "params": {
          "passportNumber": "L898902C3",
          "dateOfBirth": "740812",
          "dateOfExpiry": "120415",
          "timeoutMs": 1000
        },
        "timestamp": 0
      }
    },
    {
      "expect": {
        "type": "event",
        "version": 2,
        "domain": "nfc",
        "event": "scanProgress",
        "requestId": "r1",
        "data": {
          "step": "waiting_for_tag",
          "percent": 0
        }
      }
    },
    {
      "advance": 1000
    },
    {
      "expect": {
        "type": "response",
        "version": 2,
        "domain": "nfc",
        "requestId": "r1",
        "success": false,
        "error": {
          "code": "TIMEOUT",
          "details": {
            "origin": "native"
          }
        }
      }
    }
  ]
}
