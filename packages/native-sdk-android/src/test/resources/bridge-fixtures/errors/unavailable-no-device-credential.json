{
  "name": "errors/unavailable-no-device-credential",
  "given": {
    "capabilities": "no_device_credential",
    "provider": {
      "secureStorage.set": {
        "fail": "no_device_credential"
      }
    }
  },
  "steps": [
    {
      "send": {
        "type": "request",
        "version": 2,
        "id": "r1",
        "domain": "secureStorage",
        "method": "set",
        "params": {
          "key": "self_mnemonic",
          "value": "word list",
          "protection": "userPresence"
        },
        "timestamp": 0
      }
    },
    {
      "expect": {
        "type": "response",
        "version": 2,
        "domain": "secureStorage",
        "requestId": "r1",
        "success": false,
        "error": {
          "code": "UNAVAILABLE",
          "details": {
            "reason": "no_device_credential"
          }
        }
      }
    }
  ]
}
