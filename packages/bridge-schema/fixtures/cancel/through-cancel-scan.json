{
  "name": "cancel/through-cancel-scan",
  "given": {
    "capabilities": "full",
    "provider": {
      "nfc.scanPassport": {
        "pending": true
      }
    }
  },
  "steps": [
    {
      "send": {
        "type": "request",
        "version": 2,
        "id": "r1",
        "domain": "nfc",
        "method": "scanPassport",
        "params": {
          "passportNumber": "L898902C3",
          "dateOfBirth": "740812",
          "dateOfExpiry": "120415"
        },
        "timestamp": 0
      }
    },
    {
      "send": {
        "type": "request",
        "version": 2,
        "id": "r2",
        "domain": "nfc",
        "method": "cancelScan",
        "params": {},
        "timestamp": 0
      }
    },
    {
      "expect": {
        "type": "response",
        "version": 2,
        "domain": "nfc",
        "requestId": "r1",
        "success": false,
        "error": {
          "code": "CANCELLED"
        }
      }
    },
    {
      "expect": {
        "type": "response",
        "version": 2,
        "domain": "nfc",
        "requestId": "r2",
        "success": true
      }
    }
  ]
}
