{
  "name": "errors/cancelled",
  "given": {
    "capabilities": "full",
    "provider": {
      "biometrics.authenticate": {
        "pending": true
      }
    }
  },
  "steps": [
    {
      "send": {
        "type": "request",
        "version": 2,
        "id": "r1",
        "domain": "biometrics",
        "method": "authenticate",
        "params": {
          "reason": "Confirm it is you"
        },
        "timestamp": 0
      }
    },
    {
      "send": {
        "type": "cancel",
        "version": 2,
        "id": "c1",
        "domain": "biometrics",
        "requestId": "r1",
        "reason": "navigation",
        "timestamp": 0
      }
    },
    {
      "expect": {
        "type": "response",
        "version": 2,
        "domain": "biometrics",
        "requestId": "r1",
        "success": false,
        "error": {
          "code": "CANCELLED",
          "details": {
            "origin": "native"
          }
        }
      }
    }
  ]
}
