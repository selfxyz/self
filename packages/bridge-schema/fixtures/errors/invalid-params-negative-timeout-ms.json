{
  "name": "errors/invalid-params-negative-timeout-ms",
  "given": {
    "capabilities": "full",
    "provider": {
      "camera.scanMRZ": {
        "pending": true
      }
    }
  },
  "steps": [
    {
      "send": {
        "type": "request",
        "version": 2,
        "id": "r1",
        "domain": "camera",
        "method": "scanMRZ",
        "params": {
          "timeoutMs": -1
        },
        "timestamp": 0
      }
    },
    {
      "expect": {
        "type": "response",
        "version": 2,
        "domain": "camera",
        "requestId": "r1",
        "success": false,
        "error": {
          "code": "INVALID_PARAMS",
          "details": {
            "field": "timeoutMs"
          }
        }
      }
    }
  ]
}
