{
  "name": "errors/unavailable-not-enrolled",
  "given": {
    "capabilities": "full",
    "provider": {
      "biometrics.authenticate": {
        "fail": "not_enrolled"
      }
    }
  },
  "steps": [
    {
      "send": {
        "type": "request",
        "version": 2,
        "id": "r1",
        "domain": "biometrics",
        "method": "authenticate",
        "params": {
          "reason": "Confirm it is you"
        },
        "timestamp": 0
      }
    },
    {
      "expect": {
        "type": "response",
        "version": 2,
        "domain": "biometrics",
        "requestId": "r1",
        "success": false,
        "error": {
          "code": "UNAVAILABLE",
          "details": {
            "reason": "not_enrolled"
          }
        }
      }
    }
  ]
}
