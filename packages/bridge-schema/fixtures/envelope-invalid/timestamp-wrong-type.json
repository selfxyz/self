{
  "name": "envelope-invalid/timestamp-wrong-type",
  "given": {
    "capabilities": "full"
  },
  "steps": [
    {
      "send": {
        "type": "request",
        "version": 2,
        "id": "r1",
        "domain": "nfc",
        "method": "getStatus",
        "params": {},
        "timestamp": "now"
      }
    },
    {
      "expect": {
        "type": "response",
        "version": 2,
        "domain": "nfc",
        "requestId": "r1",
        "success": false,
        "error": {
          "code": "INVALID_PARAMS",
          "details": {
            "field": "timestamp"
          }
        }
      }
    }
  ]
}
