node-linker=hoisted
auto-install-peers=true
strict-peer-dependencies=false
# circom_tester is overridden to a github: ref (see pnpm-workspace.yaml overrides);
# pnpm 11's default block on exotic subdeps rejects it. Re-enable once MT-21/MT-22
# migrate circom_tester to a registry release and the github: override is removed.
block-exotic-subdeps=false
