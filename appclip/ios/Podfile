# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command("node", ["-p",
                                                 'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, "15.0"
use_frameworks!
prepare_react_native_project!

# Set the required architectures for simulator and device builds
$RN_ARCH_SIMULATOR = ["i386", "x86_64"]
$RN_ARCH_DEVICE = ["armv7", "armv7s", "arm64"]

linkage = ENV["USE_FRAMEWORKS"]
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# This is the App Clip target - the only one we need
target "SelfClip" do
  config = use_native_modules!

  # App Clip specific dependencies
  pod "QKMRZScanner", :modular_headers => true
  pod "NFCPassportReader", :git => "https://github.com/zk-passport/NFCPassportReader", commit: "e3e869b14fb7fb2417928079db3967f203523580", :modular_headers => true
  pod "SwiftQRScanner", :git => "https://github.com/vinodiOS/SwiftQRScanner", :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => false,
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
  )
end

# The AppClip target - commented out to avoid duplicate product conflict
# Uncomment and comment out the target above if you specifically need to work with the AppClip
